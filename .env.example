# Copiare in .env e valorizzare. NON committare .env (contiene segreti).
DATABASE_URL="postgresql://postgres:password@localhost:5433/fasciolo_macchine"
AUTH_SECRET="cambiami-con-una-stringa-casuale-lunga"
UPLOAD_DIR="./uploads"

# --- Gestionale ZATO (SQL Server, sola lettura) ---
SQLSERVER_HOST="192.168.1.144"
SQLSERVER_PORT="1433"
SQLSERVER_DATABASE="ZATO"
SQLSERVER_USER=""
SQLSERVER_PASSWORD=""
SQLSERVER_ENCRYPT="false"
SQLSERVER_TRUST_CERT="true"

# --- Timbratore (presenze/ore) ---
PRESENCE_FEED_URL="https://timbratore.zato.servonet.it/it/stampings"
PRESENCE_FEED_LOGIN_URL=""
PRESENCE_FEED_USER=""
PRESENCE_FEED_PASS=""
PRESENCE_FEED_USER_FIELD="username"
PRESENCE_FEED_PASS_FIELD="password"
PRESENCE_USERS_URL="https://timbratore.zato.servonet.it/it/users"
PRESENCE_SYNC_INTERVAL_MIN="10"

# --- Google / Gmail (invio rapportini) ---
# Google Cloud Console: abilitare la Gmail API; schermata consenso "Internal"
# (Workspace ZATO) con scope gmail.send + userinfo.email; credenziali "ID client
# OAuth 2.0" di tipo Applicazione web con redirect URI = GOOGLE_REDIRECT_URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/google/callback"
# Facoltativa: chiave di cifratura dei token salvati a DB (default: AUTH_SECRET).
GOOGLE_TOKEN_ENC_KEY=""

#link sito machines.zatospa.it