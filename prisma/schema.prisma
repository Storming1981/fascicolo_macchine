generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESPONSABILE_CANTIERI
  CAPO_OFFICINA
  MONTATORE
  CABLATORE
  PROGRAMMATORE
  COLLAUDATORE
  TECNICO_CAMPO
  LOGISTICA
  CLIENTE // utente esterno: accesso al portale del proprio cliente (solo chat pubbliche)
}

enum MachineStatus {
  PRODUCTION
  TESTING
  SHIPPED
  INSTALLED
  MAINTENANCE
  SCRAPPED
}

enum DiaryPhase {
  PRODUCTION
  TESTING
  SHIPPED
  INSTALLED
  MAINTENANCE
  SCRAPPED
}

enum SignMethod {
  PEN
  PIN
}

enum CollaudoStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  APPROVED
}

enum InterventoStatus {
  /// Primo step: l'intervento esiste ma la documentazione di sicurezza (P.O.S.)
  /// non e' ancora stata caricata e validata dal responsabile → non pianificabile.
  DOCUMENTAZIONE
  NUOVO
  PIANIFICATO
  IN_CORSO
  COMPLETATO
  FATTURATO
}

enum MessageDirection {
  IN
  OUT
}

/// Visibilità di un messaggio della chat intervento:
/// INTERNAL = solo operatori ZATO; PUBLIC = visibile anche al cliente nel portale.
enum MessageVisibility {
  INTERNAL
  PUBLIC
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  passwordHash   String
  role           Role     @default(MONTATORE)
  pinHash        String?
  signatureImage String? // dataURL della firma personale
  active         Boolean  @default(true)
  zona           String?  // zona operativa del tecnico (service): Nord-Ovest, Centro, ...
  matricola      String?  @unique // matricola dipendente (timbratore)
  badgeId        String?  @unique // badge RFID per match con le presenze in cantiere
  phone          String?  // telefono dipendente
  photo          String?  @db.Text // foto profilo (dataURL)
  reparto        String?  // reparto (timbratore): PRO, APV, UTE…
  siteManager    Boolean  @default(false) // responsabile di cantiere
  posValidator   Boolean  @default(false) // puo' validare il P.O.S. degli interventi (responsabile sicurezza)
  appAccess      String?  // override guscio: "desktop" | "field" (null = default ruolo)
  customerId     String?  // per gli utenti CLIENTE: azienda cliente di appartenenza
  createdAt      DateTime @default(now())

  customer       Customer?    @relation("CustomerUsers", fields: [customerId], references: [id], onDelete: Cascade)
  diaryEvents    DiaryEvent[]
  signatures     Signature[]
  photos         Photo[]
  collauduFatti  Collaudo[]   @relation("CollaudoCompiler")
  collauduAppr   Collaudo[]   @relation("CollaudoApprover")
  interventiAssegnati Intervento[] @relation("InterventoTech")
  interventiPartecipati Intervento[] @relation("InterventoParticipants")
  interventoDocs InterventoDocument[] @relation("InterventoDocUser")
  posValidati    Intervento[] @relation("InterventoPosValidator")
  presences      TechPresence[]
  googleToken    GoogleToken?
}

/// Token OAuth Google PERSONALE di un utente, per inviare le email dalla propria
/// casella Gmail. I token sono cifrati (src/lib/crypto.ts). La casella aziendale
/// (fallback) è invece nel Setting `googleAccount`.
model GoogleToken {
  userId       String    @id
  email        String    // indirizzo Gmail collegato
  refreshToken String    // cifrato
  accessToken  String?   // cifrato
  expiresAt    DateTime? // scadenza access token
  scope        String?
  connectedAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Machine {
  id              String        @id @default(cuid())
  code            String        @unique // M-2026-0142
  job             String        // Job Number = commessa di vendita
  jobBody         String?       // Corpo trituratore (BLUE DEVIL)
  jobContainer    String?       // Container (BLUE DEVIL)
  plantType       String?       // Tipologia impianto: BLUE DEVIL, BLUE SHARK, ...
  model           String
  year            Int
  customer        String
  country         String
  countryCode     String        @default("IT")
  site            String?
  status          MachineStatus @default(PRODUCTION)
  progress        Int           @default(0)
  productionStart DateTime?
  deliveryDate    DateTime?
  pressureSettings String?
  plateWeight     String?
  platePower      String?
  plateVoltage    String?
  notes           String?
  // Dati sincronizzati dal gestionale ZATO (ERP) — vedi src/lib/erpSync.ts
  erpDescription  String?       // co_descr1 della commessa di vendita
  erpHours        Float?        // ore di lavorazione totali (somma avlavp.lce_tempese)
  erpSyncedAt     DateTime?     // ultima sincronizzazione riuscita
  // Ordini di produzione selezionati (impianti nuovi, commessa 999999999)
  erpBodyOrder    String?       // chiave ordine corpo: "tipork|anno|serie|numero"
  erpContainerOrder String?     // chiave ordine container
  erpStandOrder   String?       // chiave ordine cavalletto
  erpBladesOrder  String?       // chiave ordine lame
  // Snapshot completo dei dati gestionale (jobs + ordini + articoli) dal
  // sync-agent, per mostrare la card ERP ricca sulla VPS (senza ERP diretto).
  erpSnapshot     Json?
  customerId      String?       // anagrafica cliente condivisa (service) — opzionale
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  components  Component[]
  diaryEvents DiaryEvent[]
  photos      Photo[]
  documents   Document[]
  signatures  Signature[]
  milestones  MachineMilestone[]
  collaudo    Collaudo?
  customerRef Customer?    @relation(fields: [customerId], references: [id])
  interventi  Intervento[]
  conversations Conversation[]

  @@index([customerId])
}

model Collaudo {
  id                String         @id @default(cuid())
  machineId         String         @unique
  status            CollaudoStatus @default(DRAFT)
  answers           Json           @default("{}") // { "1": {value:"SI"|"NO"|"NA", note:""}, ... }
  compilerId        String?
  compilerName      String?
  compiledAt        DateTime?
  compilerSignature String? // dataURL
  approverId        String?
  approverName      String?
  approvedAt        DateTime?
  approverSignature String? // dataURL
  approverRemarks   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  machine  Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  compiler User?   @relation("CollaudoCompiler", fields: [compilerId], references: [id])
  approver User?   @relation("CollaudoApprover", fields: [approverId], references: [id])

  @@index([machineId])
}

model MachineMilestone {
  id        String   @id @default(cuid())
  machineId String
  key       String // production_start | production_end | testing | shipped | installed | service | scrapped
  date      DateTime
  source    String   @default("MANUALE") // MANUALE | GESTIONALE
  note      String?
  updatedAt DateTime @updatedAt

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, key])
  @@index([machineId])
}

model Component {
  id        String  @id @default(cuid())
  machineId String
  groupId   String // gearboxes, hyd_motors, ... oppure "custom-<uuid>"
  label     String? // nome del gruppo per i componenti CUSTOM (non a catalogo)
  brand     String?
  extra     Json?
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  items     ComponentItem[]

  @@unique([machineId, groupId])
  @@index([machineId])
}

model ComponentItem {
  id          String  @id @default(cuid())
  componentId String
  position    Int
  label       String
  serial      String?
  note        String?
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)
  photos      Photo[]

  @@index([componentId])
}

model DiaryEvent {
  id        String     @id @default(cuid())
  machineId String
  phase     DiaryPhase
  type      String     @default("note") // replace | inspect | repair | note | milestone
  title     String
  note      String?
  date      DateTime   @default(now())
  actorName String
  oldSerial String?
  newSerial String?
  componentRef String?
  authorId  String?
  createdAt DateTime   @default(now())

  machine   Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  author    User?       @relation(fields: [authorId], references: [id])
  signature Signature?
  photos    Photo[]

  @@index([machineId])
}

model Signature {
  id           String     @id @default(cuid())
  machineId    String
  diaryEventId String?    @unique
  role         String // Montaggio, Collaudo, Capo officina...
  signerName   String
  signerId     String?
  method       SignMethod @default(PEN)
  imageData    String?    @db.Text // dataURL of pen signature
  hash         String
  signedAt     DateTime   @default(now())

  machine    Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  diaryEvent DiaryEvent? @relation(fields: [diaryEventId], references: [id], onDelete: Cascade)
  signer     User?       @relation(fields: [signerId], references: [id])

  @@index([machineId])
}

model Photo {
  id              String   @id @default(cuid())
  machineId       String?
  diaryEventId    String?
  componentItemId String?
  interventoId    String?  // foto di un intervento di service (cantiere)
  path            String // /uploads/...
  category        String   @default("produzione")
  caption         String?
  authorName      String?
  authorId        String?
  takenAt         DateTime @default(now())
  createdAt       DateTime @default(now())

  machine       Machine?       @relation(fields: [machineId], references: [id], onDelete: Cascade)
  diaryEvent    DiaryEvent?    @relation(fields: [diaryEventId], references: [id], onDelete: SetNull)
  componentItem ComponentItem? @relation(fields: [componentItemId], references: [id], onDelete: SetNull)
  intervento    Intervento?    @relation(fields: [interventoId], references: [id], onDelete: Cascade)
  author        User?          @relation(fields: [authorId], references: [id])

  @@index([machineId])
  @@index([interventoId])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Catalogo articoli/ricambi copiato dal gestionale (tabella `artico`) dal
/// sync-agent. Serve all'autocomplete dei ricambi nel rapportino quando la VPS
/// non ha connessione diretta al SQL Server aziendale.
model ErpArticle {
  code        String   @id // ar_codart (trimmed)
  description String   @default("")
  updatedAt   DateTime @updatedAt

  @@index([description])
}

/// Ordini di produzione di una commessa (dal gestionale, tabella avlavp) copiati
/// dal sync-agent, per popolare le tendine "Ordine Corpo/Container" sulla VPS
/// (impianti nuovi, commessa 999999999).
model ErpCommessaOrder {
  id              String    @id @default(cuid())
  commessa        Int
  key             String // "tipork|anno|serie|numero"
  tipork          String
  anno            Int
  serie           String    @default("")
  num             Int
  mainArticleCode String?
  mainArticleDesc String?
  hours           Float     @default(0)
  start           DateTime?
  end             DateTime?
  rows            Int       @default(0)
  articleCount    Int       @default(0)
  updatedAt       DateTime  @updatedAt

  @@unique([commessa, key])
  @@index([commessa])
}

model Document {
  id         String   @id @default(cuid())
  machineId  String
  name       String
  path       String
  sizeBytes  Int      @default(0)
  category   String   @default("documento")
  uploadedAt DateTime @default(now())

  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
}

// ---- Modulo Service ----

/// Anagrafica cliente condivisa (service + fascicolo). Agganciabile a ERP anagra.an_conto.
model Customer {
  id           String   @id @default(cuid())
  code         String   @unique // C-031, o codice interno
  name         String
  city         String?
  province     String?  // sigla provincia (BS, CR, ...)
  country      String   @default("Italia")
  countryCode  String   @default("IT")
  contractType String?  // Premium | Standard | ...
  phone        String?
  email        String?
  erpConto     Int?     // anagra.an_conto del gestionale ZATO
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sites         Site[]
  interventi    Intervento[]
  machines      Machine[]
  conversations Conversation[]
  users         User[]         @relation("CustomerUsers") // accessi portale cliente
}

/// Cantiere / stabilimento di un cliente (con geolocalizzazione per la mappa).
model Site {
  id         String   @id @default(cuid())
  customerId String
  name       String   // es. "Stabilimento Brescia"
  city       String?
  province   String?
  address    String?
  lat        Float?
  lng        Float?
  status     String   @default("ok") // ok | in_corso | alert
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer   Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  interventi Intervento[]
  presences  TechPresence[]

  @@index([customerId])
}

/// Intervento di service in cantiere. Collega il fascicolo macchina (machineId).
model Intervento {
  id            String           @id @default(cuid())
  code          String           @unique // INT-2487
  title         String
  description   String?
  status        InterventoStatus @default(DOCUMENTAZIONE)
  type          String           @default("MANUTENZIONE") // INSTALLAZIONE | MANUTENZIONE | RIPARAZIONE | SOSTITUZIONE | COLLAUDO | FORMAZIONE | TAGLIO | ALTRO
  priority      Int              @default(3) // 1 = critico/P1, 2 = alto, 3 = normale
  channel       String?          // portale | whatsapp | telegram | email | telefono
  reportedBy    String?          // nome contatto cliente che ha segnalato
  commessa      String?          // commessa cantiere 9 cifre (codice parlante) → timbratore
  customerId    String?
  siteId        String?
  machineId     String?          // fascicolo macchina coinvolto
  assignedTechId String?         // responsabile di cantiere / supervisore (User)
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  invoicedAt    DateTime?
  slaDueAt      DateTime?
  // P.O.S. (Piano Operativo di Sicurezza): documento obbligatorio prima di
  // poter assegnare o pianificare l'intervento. Il file sta in
  // InterventoDocument con category = "pos"; qui c'e' la VALIDAZIONE del
  // responsabile (flag + firma), senza la quale l'intervento resta in
  // stato DOCUMENTAZIONE.
  posValidated       Boolean   @default(false)
  posValidatedAt     DateTime?
  posValidatedById   String?
  posValidatedByName String?
  posSignature       String?   // path firma del responsabile (/uploads/...)
  posNote            String?
  // Cestino (soft-delete): interventi creati per errore o per test. Restano nel
  // DB ma spariscono da tutte le liste; ripristinabili dal Cestino.
  deletedAt     DateTime?
  deletedByName String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  site       Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  machine    Machine?    @relation(fields: [machineId], references: [id], onDelete: SetNull)
  tech         User?     @relation("InterventoTech", fields: [assignedTechId], references: [id], onDelete: SetNull)
  posValidator User?     @relation("InterventoPosValidator", fields: [posValidatedById], references: [id], onDelete: SetNull)
  participants  User[]    @relation("InterventoParticipants") // tecnici partecipanti (squadra)
  rapportini    Rapportino[]
  checklists    InterventoChecklist[]
  documents     InterventoDocument[]
  photos        Photo[]
  conversations Conversation[]

  @@index([customerId])
  @@index([machineId])
  @@index([status])
  @@index([deletedAt])
}

/// Rapportino di intervento (1:1 con Intervento). Alla chiusura genera un
/// evento di manutenzione (DiaryEvent) sul fascicolo macchina collegato.
model Rapportino {
  id              String    @id @default(cuid())
  interventoId    String
  date            DateTime  @default(now()) // giorno del rapportino (uno per giornata)
  workDescription String?
  issues          String?   // problematiche / mancanze rilevate in cantiere nella giornata
  ricambi         Json      @default("[]") // [{ code, desc, qty, note }]
  hoursWorked     Float?    // totale giornata (somma delle timbrature) — derivato
  plantHours      Float?    // ore operative dell'impianto (contaore macchina) al momento dell'intervento
  hoursByOperator Json      @default("[]") // [{ name, matricola?, hours }] aggregato — derivato
  timbrature      Json      @default("[]") // [{ name, start:"HH:MM", end:"HH:MM" }] sessioni entrata/uscita
  pdfPath         String?   // PDF firmato archiviato alla chiusura
  techName        String?
  techSignature   String?   // path firma tecnico
  techSignedAt    DateTime?
  clientName      String?
  clientSignature String?   // path firma cliente
  clientSignedAt  DateTime?
  hash            String?
  closed          Boolean   @default(false)
  // Autore del rapportino: solo lui (o un ADMIN) può modificarlo, a tutela di
  // chi lo compila. Null sui rapportini storici (grazia: modificabili come prima).
  authorId        String?
  sentAt          DateTime? // ultimo invio email del PDF
  sentTo          String?   // destinatari dell'ultimo invio
  diaryEventId    String?   // evento generato nel diario del fascicolo
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  intervento  Intervento @relation(fields: [interventoId], references: [id], onDelete: Cascade)
  revisions   RapportinoRevision[]
  attachments RapportinoAttachment[]

  @@index([interventoId])
}

/// Allegato di un rapportino: foto (scattata/caricata) o file di qualsiasi tipo.
model RapportinoAttachment {
  id             String   @id @default(cuid())
  rapportinoId   String
  path           String   // path pubblico /uploads/...
  filename       String   // nome originale
  mime           String
  size           Int
  kind           String   @default("file") // "image" | "file"
  uploadedByName String?
  createdAt      DateTime @default(now())

  rapportino Rapportino @relation(fields: [rapportinoId], references: [id], onDelete: Cascade)

  @@index([rapportinoId])
}

/// Log delle modifiche a un rapportino GIÀ FIRMATO/CHIUSO: ogni edit salva lo
/// stato precedente (snapshot) per poter risalire a chi/cosa/quando è cambiato.
model RapportinoRevision {
  id           String   @id @default(cuid())
  rapportinoId String
  editedById   String?
  editedByName String
  editedAt     DateTime @default(now())
  snapshot     Json     // stato PRECEDENTE: { date, workDescription, ricambi, hoursWorked, techName, clientName }
  note         String?  // motivo/nota della modifica

  rapportino Rapportino @relation(fields: [rapportinoId], references: [id], onDelete: Cascade)

  @@index([rapportinoId])
}

/// Documenti allegati a un intervento: caricati a mano oppure recuperati dal
/// fascicolo del tecnico su TeamSystem (source = TEAMSYSTEM, userId valorizzato).
model InterventoDocument {
  id             String   @id @default(cuid())
  interventoId   String
  name           String
  path           String // /uploads/...
  mimeType       String?
  sizeBytes      Int?
  category       String   @default("allegato") // allegato | sicurezza | formazione | dpi | altro
  source         String   @default("UPLOAD") // UPLOAD | TEAMSYSTEM
  externalId     String? // id del documento nel fascicolo TeamSystem
  userId         String? // tecnico a cui il documento si riferisce
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  intervento Intervento @relation(fields: [interventoId], references: [id], onDelete: Cascade)
  user       User?      @relation("InterventoDocUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([interventoId])
  @@index([userId])
}

/// Check list di cantiere per intervento (AMBIENTE / SICUREZZA). Compilata dal
/// responsabile di cantiere; alla chiusura (firma + data) genera un PDF.
model InterventoChecklist {
  id           String    @id @default(cuid())
  interventoId String
  type         String // AMBIENTE | SICUREZZA
  answers      Json      @default("{}") // { itemKey: "SI" | "NO" | "NA" }
  fields       Json      @default("{}") // campi testata + note libere
  compilerName String?
  compilerId   String?
  compilerSignature String? // path firma responsabile
  clientName   String?
  clientSignature String?
  compiledAt   DateTime?
  closed       Boolean   @default(false)
  pdfPath      String?
  hash         String?
  revisions    Json      @default("[]") // storico correzioni post-chiusura [{ at, byName, note? }]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  intervento Intervento @relation(fields: [interventoId], references: [id], onDelete: Cascade)

  @@unique([interventoId, type])
  @@index([interventoId])
}

/// Conversazione: portale chat nativo ZATO oppure storico importato
/// (WhatsApp/Telegram) agganciato a commessa / macchina / intervento.
model Conversation {
  id            String   @id @default(cuid())
  title         String
  channel       String   @default("native") // native | whatsapp | telegram
  contactName   String?
  customerId    String?
  machineId     String?
  interventoId  String?
  lastMessageAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  machine    Machine?    @relation(fields: [machineId], references: [id], onDelete: SetNull)
  intervento Intervento? @relation(fields: [interventoId], references: [id], onDelete: SetNull)
  messages   Message[]

  @@index([customerId])
  @@index([machineId])
  @@index([interventoId])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  direction      MessageDirection  @default(IN)
  // INTERNAL = solo ZATO; PUBLIC = visibile al cliente. Default: interno (sicuro).
  visibility     MessageVisibility @default(INTERNAL)
  authorId       String? // operatore ZATO o utente cliente che ha scritto
  authorName     String
  body           String?
  photoPath      String?
  source         String            @default("native") // native | import
  sentAt         DateTime          @default(now())
  createdAt      DateTime          @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// Presenza/timbratura di un tecnico in cantiere (feed dalla web app esterna
/// delle presenze, o inserimento manuale). Il tecnico timbra su una COMMESSA
/// (= Machine.job): il cantiere si deriva commessa → macchina → cliente → Site.
model TechPresence {
  id         String    @id @default(cuid())
  externalId String?   @unique // id timbratura nel sistema esterno (dedup sessioni)
  userId     String?
  badgeId    String? // matricola timbrata (match con User.badgeId)
  commessa   String? // job/commessa timbrata
  siteId     String? // cantiere risolto
  status     String    @default("on_site") // on_site | off
  clockIn   DateTime  @default(now())
  clockOut  DateTime?
  source    String    @default("manual") // manual | external | erp
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  site Site? @relation(fields: [siteId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([siteId])
}

/// Knowledge base ZATO: articoli/procedure/know-how del macromondo aziendale.
model KnowledgeArticle {
  id           String   @id @default(cuid())
  title        String
  category     String   @default("Generale")
  tags         String[] @default([])
  body         String   // markdown / testo
  pinned       Boolean  @default(false)
  plantType    String?  // tipologia impianto correlata (opzionale)
  authorId     String?
  authorName   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
}

/// Analisi AI generata sul corpus aziendale (chat interventi + rapportini), es.
/// problematiche ricorrenti. Separata dagli articoli manuali (KnowledgeArticle).
model KnowledgeInsight {
  id              String   @id @default(cuid())
  scope           String   @default("recurring-issues")
  model           String // modello AI usato
  data            Json // output strutturato (temi, frequenze, raccomandazioni…)
  filters         Json? // finestra temporale / tipologia impianto usate
  interventiCount Int      @default(0) // quanti interventi nel corpus analizzato
  generatedById   String?
  generatedByName String?
  createdAt       DateTime @default(now())

  @@index([scope])
}
