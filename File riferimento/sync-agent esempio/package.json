{
  "name": "zato-dashboard-sync-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Sync agent per importare Revenues e Backlog dal gestionale ZATO (SQL Server) al dashboard via HTTPS.",
  "scripts": {
    "start": "tsx src/index.ts",
    "revenues": "tsx src/index.ts --revenues",
    "backlog": "tsx src/index.ts --backlog",
    "discover": "tsx src/index.ts --discover-tables",
    "build": "tsc",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "mssql": "^10.0.4",
    "undici": "^5.28.4"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.17.50"
  }
}
