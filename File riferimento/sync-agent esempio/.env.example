# =============================================================================
# DASHBOARD VPS
# =============================================================================
# URL base del dashboard (senza /api/...). Il sync-agent costruisce da solo
# gli endpoint /api/sync/revenues, /api/sync/backlog, /api/sync/exchange-rates.
SYNC_API_BASE_URL=https://finance.zatospa.it

# API Key generata sul dashboard con:
#   npx tsx scripts/generate-sync-api-key.ts "zato-dashboard-sync-agent"
# Deve avere gli scope: sync:revenues e sync:backlog.
SYNC_API_KEY=sk_sync_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SQL SERVER GESTIONALE
# =============================================================================
SQLSERVER_HOST=192.168.1.144
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=P@ssw0rd
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true

# Database 1 (Italia, valore in EUR)
SQLSERVER_DATABASE_ZATO=ZATO
SQLSERVER_CODDITT_ZATO=ZATO
# Codice an_conto del cliente "ZATO NORTH AMERICA CORP." nel DB ZATO da escludere
# (intercompany: vendite di Zato SPA verso Zato NA). Lascia vuoto per non filtrare.
ZATO_EXCLUDE_AN_CONTO=9060484
# Lista (separata da virgola) dei valori dw_serie da escludere dal sync BACKLOG
# per il DB ZATO. Esempio: 'Z' = ordini intercompany Zato cliente di se stessa.
# Default se omesso: 'Z'. Per disattivare il filtro mettere = (vuoto).
ZATO_BACKLOG_EXCLUDE_SERIE=Z

# Database 2 (USA, valore in USD - viene convertito in EUR via tassi di cambio)
SQLSERVER_DATABASE_ZATONA=ZATONA
SQLSERVER_CODDITT_ZATONA=ZATONA
# Codice an_conto del cliente "ZATO SPA" nel DB ZATONA da escludere
# (intercompany: vendite di Zato NA verso Zato SPA). Lascia vuoto per non filtrare.
ZATONA_EXCLUDE_AN_CONTO=9040013
# Lista (separata da virgola) dei valori dw_serie da escludere dal sync BACKLOG
# per il DB ZATONA. Default: vuoto (nessun filtro).
ZATONA_BACKLOG_EXCLUDE_SERIE=

# =============================================================================
# SYNC OPTIONS
# =============================================================================
# Identificativo dell'agent (compare nei log del dashboard)
AGENT_INFO=zato-dashboard-sync-agent

# Scenario dwarehe usato per le query (di default 2002 per entrambi)
REVENUES_SCENARIO=2002
BACKLOG_SCENARIO=2002

# Tipi di record (dw_tipork) inclusi nel sync revenues.
# Usare A,D,N (Fatture immediate, Fatture differite, Note di credito).
# Escluso B (DDT): porta valore 0 ma duplicherebbe le quantita' delle fatture differite.
# Esclude anche H/O/R/Y/L (ordini, impegni, altro).
REVENUES_TIPI_RECORD=A,D,N

# Tipi di record (dw_tipork) inclusi nel sync backlog.
# Default = R (Impegno cliente). Esclude H/O/Y.
BACKLOG_TIPI_RECORD=R

# Tipi bolla/fattura ammessi (testord.td_tipobf) per il backlog.
# Default = 1 (ordini da fatturare). Esclude p.es. 0 = garanzia, che non deve
# essere conteggiata nel backlog di fatturato. Lista CSV, valori interi.
BACKLOG_TIPI_BF=1

# Stato evasione (movord.mo_flevas) ammesso per il backlog.
# Default = C (in corso, ancora da evadere). Esclude S (totalmente evaso).
# Se vuoi anche le righe parziali aggiungi 'P' (lista CSV, es. C,P).
BACKLOG_FLEVAS=C

# Data minima per il backlog (data ordine/consegna >= di questa)
BACKLOG_FROM_DATE=2022-01-01
