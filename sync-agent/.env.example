# =============================================================================
# APP (VPS) — machines.zatospa.it
# =============================================================================
# URL base dell'app (senza /api/...). L'agent costruisce da solo gli endpoint
# /api/sync/erp/machines e /api/sync/erp.
SYNC_API_BASE_URL=https://machines.zatospa.it

# API key generata sull'app con:  npx tsx scripts/gen-sync-key.ts
# La STESSA chiave deve stare anche in .env.production sulla VPS (SYNC_API_KEY).
SYNC_API_KEY=sk_sync_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# SQL SERVER GESTIONALE (Zucchetti AdHoc)
# =============================================================================
SQLSERVER_HOST=192.168.1.144
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=ZATO
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=CHANGE_ME
SQLSERVER_ENCRYPT=false
SQLSERVER_TRUST_CERT=true

# =============================================================================
# OPZIONI SYNC
# =============================================================================
# Identificativo dell'agent (compare nella risposta dell'app)
AGENT_INFO=machines-zato-erp-sync-agent
# Fascicoli per ogni POST verso la VPS
SYNC_BATCH_SIZE=50
# Query ERP in parallelo (non alzare troppo: pool SQL max 5)
SYNC_CONCURRENCY=4
