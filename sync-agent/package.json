{
  "name": "machines-zato-erp-sync-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Sync agent on-premise: legge i dati di produzione dal gestionale ZATO (SQL Server) e li invia ai fascicoli macchina su machines.zatospa.it via HTTPS.",
  "scripts": {
    "start": "tsx src/index.ts",
    "sync": "tsx src/index.ts",
    "test-conn": "tsx src/index.ts --test-conn",
    "build": "tsc",
    "start:prod": "node dist/index.js"
  },
  "dependencies": {
    "mssql": "^10.0.4",
    "undici": "^5.28.4"
  },
  "devDependencies": {
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "@types/mssql": "^9.1.5",
    "@types/node": "^20.17.50"
  }
}
