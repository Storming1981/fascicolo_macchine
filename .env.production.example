# Copiare sulla VPS come `.env.production` e valorizzare. NON committare.
# (il file .env.production è in .gitignore)

# --- Database: PostgreSQL installato sulla VPS ---
# Con network_mode: host il container vede Postgres su localhost.
DATABASE_URL="postgresql://fascicolo:PASSWORD_FORTE@localhost:5432/fascicolo_macchine"

# --- Sessioni: stringa casuale lunga (NON riusare quella di sviluppo) ---
# generala con:  openssl rand -base64 48
AUTH_SECRET="INCOLLA_QUI_UNA_STRINGA_CASUALE_LUNGA"

# --- File caricati (montati su volume /srv/machines-zato/uploads) ---
UPLOAD_DIR="/data/uploads"

# --- Timbratore (raggiungibile via Internet: funziona anche dalla VPS) ---
PRESENCE_FEED_URL="https://timbratore.zato.servonet.it/it/stampings"
PRESENCE_FEED_LOGIN_URL="https://timbratore.zato.servonet.it/it/auth/login"
PRESENCE_FEED_USER=""
PRESENCE_FEED_PASS=""
PRESENCE_FEED_USER_FIELD="username"
PRESENCE_FEED_PASS_FIELD="password"
PRESENCE_USERS_URL="https://timbratore.zato.servonet.it/it/users"
# polling presenze in-process (0 = disattivato)
PRESENCE_SYNC_INTERVAL_MIN="10"

# --- Google / Gmail (invio rapportini) ---
# ATTENZIONE: in Google Cloud Console aggiungere il redirect URI di produzione.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://machines.zatospa.it/api/google/callback"
GOOGLE_TOKEN_ENC_KEY=""

# --- AI (analisi chat + lettura matricola da foto) — opzionale ---
ANTHROPIC_API_KEY=""
# CHAT_AI_MODEL="claude-haiku-4-5-20251001"
# VISION_AI_MODEL="claude-haiku-4-5-20251001"

# --- Gestionale ZATO (SQL Server) ---
# LASCIARE VUOTO in produzione: 192.168.1.144 è un IP di LAN aziendale e NON è
# raggiungibile dalla VPS. Con queste variabili vuote l'app degrada con grazia
# (le funzioni ERP restano inattive). L'integrazione va fatta con un sync-agent
# on-premise che spinge i dati via HTTPS, come per finance.zatospa.it.
SQLSERVER_HOST=""
SQLSERVER_PORT="1433"
SQLSERVER_DATABASE="ZATO"
SQLSERVER_USER=""
SQLSERVER_PASSWORD=""
SQLSERVER_ENCRYPT="false"
SQLSERVER_TRUST_CERT="true"
